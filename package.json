{
  "name": "caregap-ai",
  "version": "0.1.0",
  "private": true,
  "description": "CareGap AI hackathon MVP — synthetic consultation note comparison assistant (skeleton)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval:generate": "node scripts/generate-eval-dataset.mjs",
    "eval:generate:v2-candidates": "node scripts/generate-eval-v2-candidates.mjs",
    "eval:test": "vitest run lib/eval",
    "eval:run": "node scripts/run-eval.mjs",
    "eval:pilot:manifest": "node scripts/generate-live-pilot-manifest.mjs",
    "eval:pilot:dry-run": "node scripts/run-live-pilot-dry-run.mjs",
    "eval:pilot:smoke:manifest": "node scripts/generate-live-smoke-manifest.mjs",
    "eval:pilot:smoke:dry-run": "node scripts/run-live-smoke-dry-run.mjs",
    "eval:pilot:smoke:live": "vite-node --config vitest.config.ts scripts/run-live-smoke-live.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
