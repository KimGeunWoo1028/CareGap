# Copy to .env.local and fill in values for your own test project.
# Never commit real keys or passwords.

# Browser-safe (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — do not expose to the browser
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
ANALYSIS_MODE=replay
# Optional: with ANALYSIS_MODE=live, set to 1 to exercise the Live web path
# without paid OpenAI calls (mock provider). Leave unset/0 for real Live.
# CARE_GAP_LIVE_MOCK=0
